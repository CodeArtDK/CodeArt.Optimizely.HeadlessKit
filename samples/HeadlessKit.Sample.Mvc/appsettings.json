    "UpdateExistingContentTypes": true,
    "UpdateExistingDisplayTemplates": true,
    "IgnoreDataLossWarnings": true
  },
  "OptimizelyGraph": {
    "GraphEndpoint": "https://cg.optimizely.com/content/v2",
    "SingleKey": "<your-single-key>",
    "ClientId": "",
    "ClientSecret": "",
    "DebugLogging": true,
    "CmsAppUrl": "<your-cms-app-url>"
  },
  "AllowedHosts": "*"
}
