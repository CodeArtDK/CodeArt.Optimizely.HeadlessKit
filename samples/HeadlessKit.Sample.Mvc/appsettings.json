{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SaaSCMS": {
    "ApiBaseUrl": "https://api.cms.optimizely.com/",
    "ApiPathPrefix": "preview3",
    "TokenEndpoint": "/oauth/token",
    "ClientId": "<your-client-id>",
    "ClientSecret": "<your-client-secret>",
