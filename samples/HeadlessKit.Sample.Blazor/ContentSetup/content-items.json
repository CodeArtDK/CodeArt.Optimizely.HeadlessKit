[
  {
    "contentType": "PortalDashboard",
    "displayName": "CloudPulse Welcome",
    "locale": "en",
    "container": "ROOT_CONTAINER_KEY",
    "routeSegment": "",
    "notes": "Public start page shown at /. No login required. Leave routeSegment empty so the CMS URL is /.",
    "properties": {
      "portalName": "CloudPulse",
      "supportEmail": "support@cloudpulse.example.com"
    },
    "composition": {
      "notes": "Optional — add any public-facing elements such as InfoCards or Announcements. User-specific elements (UsageStat, AccountDetail, BillingHistory) will render without data on this public page.",
      "sections": []
    }
  },
  {
    "contentType": "PortalDashboard",
    "displayName": "CloudPulse Portal",
    "locale": "en",
    "container": "ROOT_CONTAINER_KEY",
    "routeSegment": "portal",
    "notes": "Authenticated portal dashboard. Sibling to the start page under the same root container. CMS URL = /portal.",
    "properties": {
      "portalName": "CloudPulse",
      "supportEmail": "support@cloudpulse.example.com"
    },
    "composition": {
      "sections": [
        {
          "displayName": "Welcome Banner",
          "layout": "full-width",
          "elements": [
            {
              "contentType": "WelcomeBannerElement",
              "properties": {
                "greetingTemplate": "Welcome back, {name}!",
                "subtitle": "Here's your portal overview",
                "iconClass": "\u2601"
              }
            }
          ]
        },
        {
          "displayName": "Usage Stats",
          "layout": "4-columns",
          "elements": [
            {
              "contentType": "UsageStatElement",
              "properties": {
                "label": "API Calls",
                "unit": "/ mo",
                "iconClass": "\u26a1",
                "maxValue": 50000,
                "dataKey": "ApiCalls"
              }
            },
            {
              "contentType": "UsageStatElement",
              "properties": {
                "label": "Storage",
                "unit": "GB",
                "iconClass": "\u2601",
                "maxValue": 100,
                "dataKey": "Storage"
              }
            },
            {
              "contentType": "UsageStatElement",
              "properties": {
                "label": "Bandwidth",
                "unit": "GB",
                "iconClass": "\u2194",
                "maxValue": 500,
                "dataKey": "Bandwidth"
              }
            },
            {
              "contentType": "UsageStatElement",
              "properties": {
                "label": "Projects",
                "unit": "active",
                "iconClass": "\u2630",
                "maxValue": 25,
                "dataKey": "Projects"
              }
            }
          ]
        },
        {
          "displayName": "Info Cards",
          "layout": "3-columns",
          "elements": [
            {
              "contentType": "InfoCardElement",
              "properties": {
                "title": "Documentation",
                "description": "Browse our API docs and integration guides",
                "iconClass": "\ud83d\udcc4",
                "linkText": "View Docs"
              }
            },
            {
              "contentType": "InfoCardElement",
              "properties": {
                "title": "Support",
                "description": "Contact our support team for help with your account",
                "iconClass": "\ud83d\udcac",
                "linkText": "Get Help"
              }
            },
            {
              "contentType": "InfoCardElement",
              "properties": {
                "title": "System Status",
                "description": "Check current system health and uptime statistics",
                "iconClass": "\u2705",
                "linkText": "View Status"
              }
            }
          ]
        },
        {
          "displayName": "Announcement",
          "layout": "full-width",
          "elements": [
            {
              "contentType": "AnnouncementElement",
              "properties": {
                "title": "Scheduled Maintenance",
                "body": "System maintenance is scheduled for March 1st, 2026 from 02:00-04:00 UTC. Brief downtime is expected.",
                "severity": "info",
                "iconClass": "\u2139"
              }
            }
          ]
        }
      ]
    }
  },
  {
    "contentType": "PortalPage",
    "displayName": "Account",
    "locale": "en",
    "container": "PORTAL_DASHBOARD_CONTENT_KEY",
    "routeSegment": "account",
    "notes": "Child of the CloudPulse Portal dashboard. CMS URL = /portal/account.",
    "properties": {
      "pageTitle": "Account Settings",
      "pageDescription": "View and manage your account details"
    },
    "composition": {
      "sections": [
        {
          "displayName": "Account Details",
          "layout": "2x2-grid",
          "elements": [
            {
              "contentType": "AccountDetailElement",
              "properties": {
                "label": "Email",
                "iconClass": "\u2709",
                "displayFormat": "",
                "dataKey": "Email"
              }
            },
            {
              "contentType": "AccountDetailElement",
              "properties": {
                "label": "Plan",
                "iconClass": "\u2605",
                "displayFormat": "",
                "dataKey": "Plan"
              }
            },
            {
              "contentType": "AccountDetailElement",
              "properties": {
                "label": "Display Name",
                "iconClass": "\u263a",
                "displayFormat": "",
                "dataKey": "DisplayName"
              }
            },
            {
              "contentType": "AccountDetailElement",
              "properties": {
                "label": "Member Since",
                "iconClass": "\u270e",
                "displayFormat": "",
                "dataKey": "MemberSince"
              }
            }
          ]
        },
        {
          "displayName": "Announcement",
          "layout": "full-width",
          "elements": [
            {
              "contentType": "AnnouncementElement",
              "properties": {
                "title": "Two-Factor Authentication",
                "body": "Enable 2FA for enhanced account security. Go to Security Settings to set it up.",
                "severity": "warning",
                "iconClass": "\u26a0"
              }
            }
          ]
        }
      ]
    }
  },
  {
    "contentType": "PortalPage",
    "displayName": "Billing",
    "locale": "en",
    "container": "PORTAL_DASHBOARD_CONTENT_KEY",
    "routeSegment": "billing",
    "notes": "Child of the CloudPulse Portal dashboard. CMS URL = /portal/billing.",
    "properties": {
      "pageTitle": "Billing & Invoices",
      "pageDescription": "View your billing history and manage payment methods"
    },
    "composition": {
      "sections": [
        {
          "displayName": "Billing History",
          "layout": "full-width",
          "elements": [
            {
              "contentType": "BillingHistoryElement",
              "properties": {
                "title": "Billing History",
                "dateHeader": "Date",
                "descriptionHeader": "Description",
                "amountHeader": "Amount",
                "statusHeader": "Status",
                "emptyMessage": "No billing history available."
              }
            }
          ]
        },
        {
          "displayName": "Payment Info",
          "layout": "full-width",
          "elements": [
            {
              "contentType": "InfoCardElement",
              "properties": {
                "title": "Payment Methods",
                "description": "Manage your credit cards and payment options",
                "iconClass": "\ud83d\udcb3",
                "linkText": "Manage Payments"
              }
            }
          ]
        }
      ]
    }
  }
]
